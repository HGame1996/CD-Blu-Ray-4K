                    <h4>รับเงินทันที</h4>
                    <p>นัดรับสินค้า หรือส่งพัสดุ ได้รับเงินทันที</p>
                </div>
            </div>
        </div>

        <!-- Contact Section -->
        <div class="contact-box">
            <h2 style="margin-bottom: 10px;">ติดต่อขายได้ตลอด 24 ชั่วโมง</h2>
            <p style="color: var(--text-muted);">แอดไลน์ส่งรูปประเมินราคาได้ทันทีครับ</p>
            
            <div class="btn-group">
                <a href="tel:0627352490" class="btn btn-phone">
                    <i class="fa-solid fa-phone"></i> 062-735-2490
                </a>
                <a href="https://line.me/ti/p/~bigsee1" target="_blank" class="btn btn-line">
                    <i class="fa-brands fa-line"></i> Line: bigsee1
                </a>
            </div>
        </div>

        <footer>
            <p>© รับซื้อ CD เทป แผ่นเสียง Blu-ray 4K - ติดต่อ 062-735-2490 (Line: bigsee1)</p>
        </footer>
    </div>

    <!-- Mobile Quick Bar -->
    <div class="fixed-bottom">
        <a href="tel:0627352490" class="btn btn-phone">
            <i class="fa-solid fa-phone"></i> โทรเลย
        </a>
        <a href="https://line.me/ti/p/~bigsee1" target="_blank" class="btn btn-line">
            <i class="fa-brands fa-line"></i> แชท Line
        </a>
    </div>

</body>
</html>
