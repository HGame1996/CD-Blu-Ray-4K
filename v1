            </div>
        </div>

        <!-- How to sell -->
        <div class="steps">
            <h2 class="section-title">ขั้นตอนการขายง่ายๆ</h2>
            <div class="step-list">
                <div class="step-item">
                    <div class="step-number">1</div>
